{
  "name": "lmongolyan-kart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LMONGOLYAN KART - an online arcade kart racer built with Three.js, with real-time multiplayer, downloaded audio and kart assets.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js",
    "check:browser": "node tools/browser-check.mjs",
    "check:mobile": "node tools/mobile-check.mjs",
    "serve": "npm run build && node server/index.js",
    "start": "npm run serve"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "nanoid": "^5.1.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "puppeteer-core": "^25.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
